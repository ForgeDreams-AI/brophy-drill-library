// ─── Brophy Drill Library — Firestore rules ────────────────────────────────
// These rules cover ONLY what this site needs. The Brophy project
// (brophy-soccer-app) already has its own firestore.rules for the TeamHub
// app — MERGE the `drillLibrary` block below into that file and deploy once,
// rather than deploying this file on its own (it would overwrite the app's
// rules).
//
// ONE shared drill library (unified 2026-11-09): the team app and this
// Drill Library site BOTH read and write `drillLibrary`. A drill made in
// either app shows up in both. The old `drills` collection is no longer
// read or written by either app (its real drills were migrated into
// `drillLibrary`; kind === "point" coaching-point items were skipped and
// stay in `drills`, unread). The shared document shape is documented in
// src/lib/drillDoc.js (same comment in the team app at
// teamhub/src/lib/drillDoc.js).
//
// Model:
//   - Anyone (signed in or not) can READ drillLibrary — the library is public.
//   - Only coaches can WRITE: a user whose `users/{uid}` doc has
//     role == "admin" or role == "orgAdmin" (the same roles the TeamHub app
//     uses). Players can never add, edit or delete drills.
//   - `users` docs are readable by any signed-in user so the rule's get()
//     works; they are never written from this site (the TeamHub app owns them).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isCoach() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'orgAdmin'];
    }

    // ── drill library ──────────────────────────────────────────────────────
    match /drillLibrary/{drillId} {
      allow read: if true;
      allow create: if isCoach()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if isCoach();
    }

    // ── drill suggestions (the review queue / limbo) ─────────────────────
    // Anyone signed in can suggest a video from the Soccer Video Library;
    // only coaches can remove one (approve = create the drill, then delete;
    // dismiss = delete). A suggestion is just name / category / video /
    // source — no private data. Reads are signed-in so the suggest flow can
    // check for an existing suggestion with the same video.
    match /drillSuggestions/{suggestionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.suggestedByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 0;
      allow update, delete: if isCoach();
    }

    // ── users (owned by the TeamHub app; read-only here) ───────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
