// ─── Brophy Drill Library — Firestore rules ────────────────────────────────
// These rules cover ONLY what this site needs. The Brophy project
// (brophy-soccer-app) already has its own firestore.rules for the TeamHub
// app — MERGE the `drillLibrary` block below into that file and deploy once,
// rather than deploying this file on its own (it would overwrite the app's
// rules).
//
// Model:
//   - Anyone (signed in or not) can READ drillLibrary — the library is public.
//   - Only coaches can WRITE: a user whose `users/{uid}` doc has
//     role == "admin" or role == "orgAdmin" (the same roles the TeamHub app
//     uses). Players can never add, edit or delete drills.
//   - `users` docs are readable by any signed-in user so the rule's get()
//     works; they are never written from this site (the TeamHub app owns them).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isCoach() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'orgAdmin'];
    }

    // ── drill library ──────────────────────────────────────────────────────
    match /drillLibrary/{drillId} {
      allow read: if true;
      allow create: if isCoach()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if isCoach();
    }

    // ── users (owned by the TeamHub app; read-only here) ───────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
